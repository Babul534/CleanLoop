# =============================================================================
# CleanLoop Server Production & Development Environment Configuration
# =============================================================================

# Server Port (Render injects PORT dynamically; 5000 is used for local development)
PORT=5000

# Node Environment: 'production' for live deployments, 'development' for local work
NODE_ENV=production

# Primary Production Frontend URL (Allowed CORS Origin)
# Example: https://cleanloop.vercel.app
CLIENT_URL=https://cleanloop.vercel.app

# Additional Allowed CORS Origins (Comma-separated list, optional)
# Example: https://cleanloop.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://cleanloop.vercel.app,http://localhost:5173

# Optional: Allow dynamic Vercel preview deployment URLs (e.g., https://cleanloop-*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# MongoDB Atlas Connection String (M0 Free Tier)
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/cleanloop?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 32 random characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# JWT Expiration Duration (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Cloudinary Storage Configuration (Free Tier Image Storage)
# Obtain from Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Administrator Seed Account Credentials (Used by `npm run admin`)
ADMIN_NAME=Municipal Administrator
ADMIN_EMAIL=admin@cleanloop.internal
ADMIN_PASSWORD=SetAStrongPassword2026!
