# =============================================================================
# CleanLoop Client Environment Configuration (Vite)
# =============================================================================

# Backend API Endpoint URL
# Development default: http://localhost:5000/api
# Production (Vercel): Set to your deployed Render backend service URL
VITE_API_BASE_URL=https://cleanloop-api.onrender.com/api

# OpenStreetMap Map Tile Server (Free OpenStreetMap Standard Tiles)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
